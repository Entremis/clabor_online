{
  "name": "clabor-scorekeeper",
  "version": "2.0.0",
  "private": true,
  "description": "Локальный счётчик очков для клабора",
  "scripts": {
    "start": "node build.cjs --prepare && node dev-server.cjs",
    "build": "node build.cjs",
    "preview": "node dev-server.cjs --preview",
    "test": "node --test tests/*.test.cjs",
    "cloud:dev": "wrangler dev --config cloud-worker/wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "cloud:deploy": "wrangler deploy --config cloud-worker/wrangler.jsonc",
    "cloud:migrate": "wrangler d1 migrations apply clabor-data --remote --config cloud-worker/wrangler.jsonc"
  },
  "overrides": {"miniflare": {"sharp": "^0.35.4"}},
  "dependencies": {
    "dexie": "^4.4.4"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "wrangler": "^4.130.0"
  }
}
